# Local configuration template (NOT tracked by Git)
# Copy this file to ~/.bashrc.local or $DOTFILES_DIR/.bashrc.local and customize it.

# API Keys
export GEMINI_API_KEY="your_gemini_api_key_here"
export DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# Custom project root path
export PROJECTS_ROOT="/c/dev/projects"

# Custom GitReview tool settings
export GIT_REVIEW_PROVIDER="gemini"

# ==============================================================================
# SSH KEYS CONFIGURATION
# Add paths to your private SSH keys below.
# The SSH Agent will automatically load these keys when starting a session.
# Examples:
#   Windows path format:  "C:/dev/private_key" or "/c/dev/private_key"
#   Linux / Home format:  "$HOME/.ssh/id_ed25519_personal"
# ==============================================================================
SSH_KEYS=(
    "C:/dev/private_key"
    "$HOME/.ssh/id_ed25519_personal"
)

# Machine-specific aliases
# alias work='cd /c/work/projects'

# ==============================================================================
# PROJECT NAVIGATION CONFIGURATION
# ==============================================================================
# Base directory for all your projects
export PROJECTS_ROOT="/c/dev/projects"

# Declare associative array globally (-g)
declare -g -A PROJECT_PATHS=(
    ["syn"]="synthesis_newdesign/web"
    ["syn_old"]="synthesis_old/web"
    ["syn_pub_uat"]="synthesis_publish_uat/web"
    ["syn_pub_live"]="synthesis_publish_live/web"
    ["oms"]="oms/web"
    ["pin"]="pinergy/web"
    ["dop"]="pinergy/web"
)