# ==============================================================================
# LOCAL CONFIGURATION (NOT tracked by Git)
# ==============================================================================
# All personal / machine-specific settings are configured HERE in this one file.
# Copy this file to ~/.bashrc.local and customize it with your settings.
# Running ./install.sh will automatically apply everything to your system.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Git Identity (install.sh automatically syncs this to ~/.gitconfig.local)
# ------------------------------------------------------------------------------
export GIT_USER_NAME="Artem Ignatiev"
export GIT_USER_EMAIL="artem.ignatiev@omegasoftware.de"

# ------------------------------------------------------------------------------
# 2. SSH Keys to load into ssh-agent upon terminal start
# ------------------------------------------------------------------------------
# Specify paths to private keys in OpenSSH format (NOT .ppk!).
# Example: /c/dev/private_key or $HOME/.ssh/id_rsa
SSH_KEYS=(
    "/c/dev/private_key"
    "$HOME/.ssh/id_ed25519_personal"
    "$HOME/.ssh/id_rsa"
)

# ------------------------------------------------------------------------------
# 3. API Keys & AI Providers
# ------------------------------------------------------------------------------
export OPENROUTER_API_KEY="your_openrouter_api_key_here"
export OPENROUTER_MODEL="poolside/laguna-s-2.1:free"
export GIT_REVIEW_PROVIDER="openrouter"

export GEMINI_API_KEY="your_gemini_api_key_here"
export DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# ------------------------------------------------------------------------------
# 4. Project Navigation (`proj <alias>` command)
# ------------------------------------------------------------------------------
export PROJECTS_ROOT="/c/dev/projects"

declare -g -A PROJECT_PATHS=(
    ["syn"]="synthesis_newdesign/web"
    ["syn_old"]="synthesis_old/web"
    ["syn_pub_uat"]="synthesis_publish_uat/web"
    ["syn_pub_live"]="synthesis_publish_live/web"
    ["oms"]="oms/web"
    ["pin"]="pinergy/web"
    ["dop"]="pinergy/web"
)
