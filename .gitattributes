# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force shell scripts and configs to LF
*.sh text eol=lf
*.bash text eol=lf
.bashrc* text eol=lf
.gitconfig* text eol=lf
.gitignore text eol=lf
*.md text eol=lf

# Windows batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
