# Git configuration - PUBLIC (shared on GitHub)
# Personal settings are stored in ~/.gitconfig.local

[include]
    path = ~/.gitconfig.local

[alias]
    get = "!f(){ \
        echo \"[GET] $(date '+%d-%m-%Y_%H-%M-%S')\"; \
        git pull origin \"$(git rev-parse --abbrev-ref HEAD)\" && \
        git submodule update; \
    }; f"
    
    shr = "!f(){ git push origin \"$(git rev-parse --abbrev-ref HEAD)\"; }; f"
    
    brd = push origin --delete
    
    upd = "!f(){ \
        local branch; \
        branch=$(git rev-parse --abbrev-ref HEAD) || return 1; \
        local old_stash new_stash; \
        old_stash=$(git rev-parse -q --verify refs/stash 2>/dev/null || true); \
        git stash push -q -m \"upd-temp\"; \
        new_stash=$(git rev-parse -q --verify refs/stash 2>/dev/null || true); \
        git pull origin \"$branch\"; \
        local status=$?; \
        if [ \"$old_stash\" != \"$new_stash\" ]; then \
            git stash pop; \
        fi; \
        return $status; \
    }; f"
    
    cows = "!f(){ \
        if [ -z \"$1\" ]; then \
            echo \"Usage: git cows <branch>\" >&2; \
            return 1; \
        fi; \
        local target=\"$1\"; \
        local old_stash new_stash; \
        old_stash=$(git rev-parse -q --verify refs/stash 2>/dev/null || true); \
        git stash push -q -m \"cows-temp\"; \
        new_stash=$(git rev-parse -q --verify refs/stash 2>/dev/null || true); \
        if ! git checkout \"$target\"; then \
            if [ \"$old_stash\" != \"$new_stash\" ]; then \
                echo \"Checkout failed; restoring stashed changes...\" >&2; \
                git stash pop -q; \
            fi; \
            return 1; \
        fi; \
        local branch; \
        branch=$(git rev-parse --abbrev-ref HEAD); \
        git pull origin \"$branch\"; \
        if [ \"$old_stash\" != \"$new_stash\" ]; then \
            git stash pop; \
        fi; \
    }; f"
    
    snap = "!f(){ \
        if [ -z \"$(git status --porcelain -uno)\" ]; then \
            echo \"No local changes to snapshot.\" >&2; \
            return 0; \
        fi; \
        TS=$(date '+%d-%m-%Y_%H-%M-%S'); \
        git stash push -m \"SNAPSHOT_$TS\" && \
        git stash apply && \
        git stash list; \
    }; f"
    
    gas = pull origin
    
    sas = "!f(){ \
        if [ -z \"$1\" ]; then \
            echo \"Usage: git sas <remote_branch_name>\" >&2; \
            return 1; \
        fi; \
        git push origin \"$(git rev-parse --abbrev-ref HEAD):$1\"; \
    }; f"
    
    cos = "!f(){ \
        if [ -z \"$1\" ]; then \
            echo \"Usage: git cos <branch>\" >&2; \
            return 1; \
        fi; \
        git checkout \"$1\" && git status; \
    }; f"
    
    chistory = history
    br = branch
    ci = commit
    cl = clean -d -f
    co = checkout
    chng = log -p -2
    dump = cat-file -p
    list = log --pretty=oneline
    history = log --pretty=format:\"\t\t%h  %ad  | [%an]: %s%d\" --graph --date=short
    rs = reset --hard
    st = status
    type = cat-file -t
    undo = reset --soft HEAD~1
    unstage = reset HEAD --
    visual = !gitk
    tlog = !sh -c 'tortoisegitproc /command:log'
    tcmt = !sh -c 'tortoisegitproc /command:commit'
    exp = "!f(){ if command -v explorer >/dev/null 2>&1; then explorer .; elif command -v xdg-open >/dev/null 2>&1; then xdg-open .; fi; }; f"
    last = log -1 --decorate
    
    # Automatically bump patch version (e.g., v1.0.2 -> v1.0.3), create tag, and push to origin
    bump = "!f(){ \
        LATEST=$(git tag -l \"v[0-9]*\" -l \"[0-9]*\" --sort=-v:refname | head -n 1); \
        if [ -z \"$LATEST\" ]; then \
            NEXT=\"v1.0.0\"; \
        else \
            PREFIX=$(echo \"$LATEST\" | grep -o '^[vV]'); \
            RAW=$(echo \"$LATEST\" | sed 's/^[vV]//'); \
            NEXT=\"${PREFIX}$(echo \"$RAW\" | awk -F. '{$NF = $NF + 1; print $1\".\"$2\".\"$NF}')\"; \
        fi; \
        echo \"[BUMP] ${LATEST:-no prior tag} -> $NEXT\"; \
        git tag -a \"$NEXT\" -m \"Release $NEXT\" && \
        git push origin \"$NEXT\"; \
    }; f"

[safe]
    directory = *
